# Copy to binance.env and fill in (do NOT commit binance.env)
# Binance API Management: https://www.binance.com/en/my/settings/api-management
# Futures permissions: Enable Reading (read-only is enough for klines + account check)

BINANCE_API_KEY=your_api_key_here
BINANCE_API_SECRET=your_api_secret_here

# USDT-M perpetual futures (default). Set true for testnet keys.
BINANCE_USE_TESTNET=false

# Optional default symbol base (pair-snap.ps1 uses -Bases if omitted)
BINANCE_DEFAULT_BASE=BTC
