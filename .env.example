# Copy to .env and fill in (do NOT commit .env)

# --- Telegram (push only, no trading commands) ---
TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here
TELEGRAM_PUSH_INTERVAL_MINUTES=10
TELEGRAM_PARSE_MODE=HTML
# false=只推开平仓+账户，不发盘面快报
TELEGRAM_MARKET_REPORT=false

# --- Market push ---
MARKET_PUSH_ENABLED=true
MARKET_PUSH_TOP_GAINERS=60
MARKET_PUSH_TOP_LOSERS=30
MARKET_MIN_QUOTE_VOLUME=500000
MARKET_SCAN_MAX_CANDIDATES=95
MARKET_PUSH_TOP_OI_ABNORMAL=10
MARKET_PUSH_SIGNAL_MIN_SCORE=75

# --- Paper futures (simulated, NO real orders) ---
PAPER_TRADING_ENABLED=true
PAPER_AUTO_TRADE=true
PAPER_INITIAL_BALANCE=1000
PAPER_LEVERAGE=3
PAPER_MARGIN_PCT=10
PAPER_MAX_POSITIONS=3
PAPER_OPEN_MIN_SCORE=75
PAPER_OPEN_ON_SIGNAL=true
PAPER_TAKER_FEE_RATE=0.0004
PAPER_PUSH_TRADES=true
PAPER_PUSH_STATUS_EVERY_CYCLE=true

# Optional: Binance API (NOT required for market push — public endpoints only)
# BINANCE_API_KEY=
# BINANCE_API_SECRET=
# BINANCE_USE_TESTNET=false
